#!/usr/bin/env node

import { spawn } from "node:child_process";
import { createRequire } from "node:module";
import { dirname, resolve } from "node:path";

const require = createRequire(import.meta.url);
const launcherCliEntry = require.resolve("@agent-chassis/agent-launch-cli/src/index.mjs");
const backendBin = resolve(
  dirname(launcherCliEntry),
  "../bin/agent-launch-filesystem-mcp-backend"
);

const child = spawn(backendBin, process.argv.slice(2), {
  stdio: "inherit"
});

child.on("exit", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
    return;
  }

  process.exit(code ?? 1);
});

child.on("error", (error) => {
  console.error(error instanceof Error ? error.message : String(error));
  process.exit(1);
});
