#!/bin/sh
# Launcher-owned Git wrapper mounted over the confined child's Git executables.
#
# WHY THIS EXISTS. An enforced bwrap plan overlays the controlled-contract
# private family (`wiki/contracts`) with an EMPTY read-only mount after every
# ordinary read/write mount. Real Git still reads the repository index, which
# lists those tracked paths, so an ordinary `git status` inside the namespace
# reports every hidden contract as ` D` / `deleted:`. Those rows are an artifact
# of the overlay, not of the working tree.
#
# WHAT THIS DOES. The launcher binds this one file read-only over every supported
# Git executable entrypoint in the namespace, and keeps each distinct original
# Git at a launcher-owned read-only location. Whatever path this file is started
# as, it finds the original recorded for that entrypoint and execs it. For an
# ordinary `git status` that targets the launcher-designated repository it first
# adds a root-anchored exclusion pathspec for the hidden family
# (`:(top,exclude)wiki/contracts`). Every other invocation -- a different
# subcommand, a different repository, an unparseable argv -- is exec'd through
# with its argv unchanged.
#
# WHERE ITS FACTS COME FROM. Everything is read from the launcher-owned read-only
# root named below, by path alone and with shell builtins only:
#   entrypoints/<absolute entrypoint path>  -> the directory holding the original
#   repository                              -> the designated repository
#   excluded/<n>                            -> each hidden directory below it
# Nothing comes from the environment, so a rebuilt PATH, a login profile, or a
# cleared environment changes neither the interception nor the delegation.
#
# WHAT THIS IS NOT. It is an OUTPUT/ERGONOMICS adaptation, not a confidentiality
# boundary: the empty read-only overlay is the boundary and is unchanged. An
# in-process Git library, a Git executable the launcher did not inventory, and a
# deliberate call to a preserved original are NOT adapted and still see the
# overlay rows. The wrapper never reads a private file, never inspects repository
# objects, and never mutates Git configuration or the index.
#
# ARGV, NOT COMMAND STRINGS. The subcommand is identified by walking argv past
# Git's global options (including the ones that consume a separate value), so a
# pathspec, a commit message, or a shell string that happens to contain the word
# "status" is never mistaken for the subcommand. Started through a `git-<name>`
# builtin link in Git's exec path, it runs `<name>` as the subcommand, exactly
# as Git does.
#
# TWO SHAPES, ONE MEANING. In Git's ordinary pathspec mode the exclusion is
# simply APPENDED: it is a pathspec and does not start with `-`, so no `--`
# separator has to be inserted and no caller option, pathspec, or `--` position
# is rewritten. In LITERAL pathspec mode (`--literal-pathspecs`, or a true
# `GIT_LITERAL_PATHSPECS`) an appended `:(...)` element would be read as a
# filename and would silently hide the caller's own rows, so the invocation is
# NORMALIZED instead: global literal mode is turned off for this one real-Git
# call, every caller pathspec is re-expressed with explicit `:(literal)` magic --
# which is exactly what global literal mode gave it, wildcards, brackets and
# leading colons included -- and the launcher's exclusion keeps its magic. Caller
# paths therefore mean the same thing in both shapes.
#
# `git status` has no option that consumes a separate following value, so
# everything after the subcommand that does not start with `-` (and everything
# after a `--`) is a caller pathspec, and a trailing pathspec can never be
# swallowed as an option argument. An invalid invocation stays invalid: an empty
# pathspec, and literal mode combined with another global pathspec mode, are
# refused by real Git itself and are passed through untouched rather than
# normalized into something that succeeds.
#
# An entrypoint with no recorded original, or launcher facts that cannot be
# read, is an EXPLICIT failure here, never a guess at another Git and never a
# silent unfiltered status.

set -u

wrapper_fail() {
	printf 'agent-launch git wrapper: %s\n' "$1" >&2
	exit 127
}

# Git's own environment-boolean spelling for the pathspec-mode variables.
git_env_true() {
	case $1 in
		'' | 0 | false | FALSE | False | no | NO | No | off | OFF | Off) return 1 ;;
	esac
	return 0
}

# The launcher-owned read-only root. The planner mounts it at this exact path.
launcher_root=/agent-launch-git-status-wrapper
[ -d "$launcher_root/entrypoints" ] || wrapper_fail "the launcher Git root $launcher_root is absent; this executable runs only inside a launcher namespace"

# Which entrypoint was started. The directory is canonicalized so a relative
# call, a doubled slash, or a symlinked directory all name the same entrypoint;
# a `git-<name>` builtin link shares the original of `git` beside it.
case $0 in
	*/*)
		invoked_dir=${0%/*}
		invoked_name=${0##*/}
		;;
	*)
		invoked_dir=.
		invoked_name=$0
		;;
esac
[ -n "$invoked_dir" ] || invoked_dir=/
self_dir=$(CDPATH= cd -P -- "$invoked_dir" 2>/dev/null && pwd -P) ||
	wrapper_fail "cannot resolve the directory of the invoked entrypoint: $0"
case $self_dir/ in
	"$launcher_root"/*) wrapper_fail "the invoked entrypoint is inside the launcher Git root, so it would delegate to itself: $0" ;;
esac
[ "$self_dir" != / ] || self_dir=

builtin_name=
entry_name=$invoked_name
case $invoked_name in
	git-?*)
		builtin_name=${invoked_name#git-}
		entry_name=git
		;;
esac

# A symlink alias the launcher did not inventory is followed to the entrypoint
# it resolves to, when the namespace has a `readlink` to ask.
entry=$launcher_root/entrypoints$self_dir/$entry_name
if [ ! -d "$entry" ]; then
	resolved=$(readlink -f -- "$0" 2>/dev/null) || resolved=
	case $resolved in
		/*) [ ! -d "$launcher_root/entrypoints$resolved" ] || entry=$launcher_root/entrypoints$resolved ;;
	esac
fi
[ -d "$entry" ] || wrapper_fail "no original Git is recorded for the invoked entrypoint: $0"

real_dir=$(CDPATH= cd -P -- "$entry" 2>/dev/null && pwd -P) ||
	wrapper_fail "cannot resolve the original Git recorded for the invoked entrypoint: $0"
case $real_dir/ in
	"$launcher_root"/originals/*) ;;
	*) wrapper_fail "the original Git recorded for $0 is outside the launcher Git root: $real_dir" ;;
esac
real_git=$real_dir/git
[ -x "$real_git" ] || wrapper_fail "the original Git recorded for $0 is not executable: $real_git"

[ -z "$builtin_name" ] || set -- "$builtin_name" "$@"

# Starting pathspec modes come from the environment; the global options walked
# below then override them exactly as Git's own option handling does (each flag
# sets its variable, so the last occurrence wins). Only literal mode has a
# `--no-` spelling in Git.
literal_mode=0
other_modes=0
git_env_true "${GIT_LITERAL_PATHSPECS-}" && literal_mode=1
git_env_true "${GIT_GLOB_PATHSPECS-}" && other_modes=1
git_env_true "${GIT_NOGLOB_PATHSPECS-}" && other_modes=1
git_env_true "${GIT_ICASE_PATHSPECS-}" && other_modes=1

# Walk argv past Git's global options to the actual subcommand. The options
# listed first consume a separate following value in the form matched here; the
# `--opt=value` spellings fall through to the generic `-*` arm.
argc=$#
index=1
subcommand=
literal_flags=" "
while [ "$index" -le "$argc" ]; do
	eval "arg=\${$index}"
	case $arg in
		--) exec "$real_git" "$@" ;;
		--literal-pathspecs)
			literal_mode=1
			literal_flags="$literal_flags$index "
			;;
		--no-literal-pathspecs)
			literal_mode=0
			literal_flags="$literal_flags$index "
			;;
		--glob-pathspecs | --noglob-pathspecs | --icase-pathspecs)
			other_modes=1
			;;
		-C | -c | --git-dir | --work-tree | --namespace | --super-prefix | --attr-source | --config-env)
			index=$((index + 2))
			continue
			;;
		-*)
			index=$((index + 1))
			continue
			;;
		*)
			subcommand=$arg
			break
			;;
	esac
	index=$((index + 1))
done

[ "$subcommand" = status ] || exec "$real_git" "$@"

# Scope to the launcher-designated repository. The caller's own global options
# (-C, --git-dir, --work-tree, ...) decide which repository `status` would act
# on, so the same prefix resolves the worktree root. Anything else -- an
# unrelated repository, no repository at all, a bare repository -- passes
# through unchanged.
filter_repo=$(CDPATH= cd -P -- "$launcher_root/repository" 2>/dev/null && pwd -P) ||
	wrapper_fail "cannot resolve the launcher-designated repository: $launcher_root/repository"

toplevel=$(
	keep=$((index - 1))
	remaining=$#
	taken=0
	while [ "$taken" -lt "$remaining" ]; do
		head=$1
		shift
		if [ "$taken" -lt "$keep" ]; then
			set -- "$@" "$head"
		fi
		taken=$((taken + 1))
	done
	"$real_git" "$@" rev-parse --show-toplevel 2>/dev/null
)

[ -n "$toplevel" ] || exec "$real_git" "$@"
[ "$toplevel" = "$filter_repo" ] || exec "$real_git" "$@"

# Append one root-anchored exclusion per hidden directory and run the original.
# Each exclusion is derived from the launcher's own record of what it hid.
exec_filtered() {
	for excluded in "$launcher_root"/excluded/*; do
		excluded_dir=$(CDPATH= cd -P -- "$excluded" 2>/dev/null && pwd -P) ||
			wrapper_fail "cannot resolve the launcher-hidden directory: $excluded"
		case $excluded_dir in
			"$filter_repo"/?*) ;;
			*) wrapper_fail "the launcher-hidden directory is not below the designated repository: $excluded_dir" ;;
		esac
		set -- "$@" ":(top,exclude)${excluded_dir#"$filter_repo"/}"
	done
	exec "$real_git" "$@"
}

# Ordinary pathspec mode: append and be done. Nothing about the caller's argv is
# rewritten.
if [ "$literal_mode" -eq 0 ]; then
	exec_filtered "$@"
fi

# Literal mode. Survey the caller's own pathspecs first, so the two invocations
# real Git itself rejects are handed to it untouched instead of being normalized
# into a success: an empty pathspec (`:(literal)` with an empty path would match
# everything), and literal mode combined with another global pathspec mode, which
# Git refuses as soon as any pathspec is present.
caller_pathspecs=0
separator=0
survey=$((index + 1))
while [ "$survey" -le "$argc" ]; do
	eval "arg=\${$survey}"
	pathspec=$separator
	if [ "$separator" -eq 0 ]; then
		case $arg in
			--) separator=1 ;;
			-*) ;;
			*) pathspec=1 ;;
		esac
	fi
	if [ "$pathspec" -eq 1 ]; then
		caller_pathspecs=$((caller_pathspecs + 1))
		[ -n "$arg" ] || exec "$real_git" "$@"
	fi
	survey=$((survey + 1))
done
if [ "$other_modes" -eq 1 ] && [ "$caller_pathspecs" -gt 0 ]; then
	exec "$real_git" "$@"
fi

# Rebuild: drop the global literal flags, re-express every caller pathspec with
# explicit `:(literal)` magic, and keep every option, value and `--` exactly
# where the caller put it. `GIT_LITERAL_PATHSPECS` is neutralized for this call
# because the dropped flag would otherwise still be in effect through the
# environment.
count=$#
position=1
separator=0
while [ "$position" -le "$count" ]; do
	arg=$1
	shift
	if [ "$position" -lt "$index" ]; then
		case $literal_flags in
			*" $position "*) : ;;
			*) set -- "$@" "$arg" ;;
		esac
	elif [ "$position" -eq "$index" ]; then
		set -- "$@" "$arg"
	elif [ "$separator" -eq 1 ]; then
		set -- "$@" ":(literal)$arg"
	else
		case $arg in
			--)
				separator=1
				set -- "$@" "$arg"
				;;
			-*) set -- "$@" "$arg" ;;
			*) set -- "$@" ":(literal)$arg" ;;
		esac
	fi
	position=$((position + 1))
done

GIT_LITERAL_PATHSPECS=0
export GIT_LITERAL_PATHSPECS
exec_filtered "$@"
