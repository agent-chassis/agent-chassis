{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-chassis.invalid/controlled-contract-planning-state-effect-policy.experimental.v1.schema.json",
  "title": "controlled-contract-planning-state-effect-policy.experimental.v1",
  "type": "object",
  "required": ["policy_version", "digest_domain", "state_effect_rules", "resource_limits", "mandatory_authority_exclusions"],
  "additionalProperties": false,
  "properties": {
    "policy_version": { "const": "controlled-contract-planning-state-effect-policy.experimental.v1" },
    "digest_domain": { "const": "controlled-contract:planning-state-effect-policy:v1" },
    "state_effect_rules": {
      "type": "object",
      "required": ["structural_behavior_cohesion", "structural_directed_cut", "structural_overlay", "verification_overlay", "proof_pattern_overlay", "proven_proof_atomicity", "proven_capture_atomicity", "explicit_separation", "explicit_non_join", "declared_alternative", "inclusive_alternative_overlay", "exclusion_diagnostic", "unresolved_diagnostic", "resource_affinity"],
      "additionalProperties": false,
      "properties": {
        "structural_behavior_cohesion": { "$ref": "#/$defs/rule" }, "structural_directed_cut": { "$ref": "#/$defs/rule" },
        "structural_overlay": { "$ref": "#/$defs/rule" }, "verification_overlay": { "$ref": "#/$defs/rule" },
        "proof_pattern_overlay": { "$ref": "#/$defs/rule" }, "proven_proof_atomicity": { "$ref": "#/$defs/rule" },
        "proven_capture_atomicity": { "$ref": "#/$defs/rule" }, "explicit_separation": { "$ref": "#/$defs/rule" },
        "explicit_non_join": { "$ref": "#/$defs/rule" }, "declared_alternative": { "$ref": "#/$defs/rule" },
        "inclusive_alternative_overlay": { "$ref": "#/$defs/rule" }, "exclusion_diagnostic": { "$ref": "#/$defs/rule" },
        "unresolved_diagnostic": { "$ref": "#/$defs/rule" }, "resource_affinity": { "$ref": "#/$defs/rule" }
      }
    },
    "resource_limits": {
      "type": "object",
      "required": ["verified_input_bytes", "successful_output_bytes", "resolved_nodes", "binary_edges", "nary_incidences", "candidate_pairs", "universal_occurrences", "canonicalization_states", "selected_packs", "tied_candidates"],
      "additionalProperties": false,
      "properties": {
        "verified_input_bytes": { "$ref": "#/$defs/limit" }, "successful_output_bytes": { "$ref": "#/$defs/limit" },
        "resolved_nodes": { "$ref": "#/$defs/limit" }, "binary_edges": { "$ref": "#/$defs/limit" },
        "nary_incidences": { "$ref": "#/$defs/limit" }, "candidate_pairs": { "$ref": "#/$defs/limit" },
        "universal_occurrences": { "$ref": "#/$defs/limit" }, "canonicalization_states": { "$ref": "#/$defs/limit" },
        "selected_packs": { "$ref": "#/$defs/limit" }, "tied_candidates": { "$ref": "#/$defs/limit" }
      }
    },
    "mandatory_authority_exclusions": { "$ref": "#/$defs/exclusions" }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["rule_id", "source_classes", "permitted_states", "permitted_effects", "permitted_facets", "cross_pack_identity_join"],
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "source_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "permitted_states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/state" } },
        "permitted_effects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/effect" } },
        "permitted_facets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/facet" } },
        "cross_pack_identity_join": { "const": false }
      }
    },
    "limit": {
      "type": "object",
      "required": ["limit", "unit", "count_point", "diagnostic_code", "authority", "failure_mode"],
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "count_point": { "type": "string", "minLength": 1 },
        "diagnostic_code": { "type": "string", "pattern": "^PA_[A-Z_]+$" },
        "authority": { "const": "digest_bound_package_policy" },
        "failure_mode": { "const": "fail_closed_without_sampling_or_partial_success" }
      }
    },
    "state": { "enum": ["established", "proven", "satisfied", "inactive", "not_proven", "not_assessed", "not_applicable", "ambiguous", "excluded", "residue", "missing", "invalid"] },
    "effect": { "enum": ["behavior_cohesion", "proof_atomicity", "capture_atomicity", "directed_cut", "merge_signal", "hard_contraction", "separation_signal", "overlay_only", "diagnostic_only", "never_group", "unresolved_constraint"] },
    "facet": { "enum": ["behavior_cohesion", "proof_atomicity", "exact_capture_atomicity", "implementation_ownership", "verification_ownership", "evidence_acquisition", "authority_boundary"] },
    "exclusions": {
      "type": "object",
      "required": ["proof_applicability", "optimality", "correct_ownership", "runtime_truth", "evidence_authority", "cce_consequences", "readiness", "status_transition_authority", "dispatch_authority", "mutation_or_publication_permission"],
      "additionalProperties": false,
      "properties": {
        "proof_applicability": { "const": false }, "optimality": { "const": false },
        "correct_ownership": { "const": false }, "runtime_truth": { "const": false },
        "evidence_authority": { "const": false }, "cce_consequences": { "const": false },
        "readiness": { "const": false }, "status_transition_authority": { "const": false },
        "dispatch_authority": { "const": false }, "mutation_or_publication_permission": { "const": false }
      }
    }
  }
}
