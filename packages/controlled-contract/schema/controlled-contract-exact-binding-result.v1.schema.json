{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"controlled-contract-exact-binding-result.v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","authority","provenance","context","satisfaction","binding_set_sha256","bindings","relation_results","diagnostics"],
  "properties":{
    "schema_version":{"const":"controlled-contract-exact-binding-result.v1"},
    "authority":{
      "type":"object","additionalProperties":false,"required":["kind","authoritative"],
      "properties":{"kind":{"const":"local"},"authoritative":{"const":false}}
    },
    "provenance":{
      "type":"object","additionalProperties":false,
      "required":["kind","capture_verified","filesystem_paths_authoritative","snapshot_completeness_authoritative","caller_values_authoritative","runtime_truth_authoritative"],
      "properties":{
        "kind":{"enum":["local_deterministic_capture","unadmitted_direct"]},
        "capture_verified":{"type":"boolean"},
        "filesystem_paths_authoritative":{"const":false},
        "snapshot_completeness_authoritative":{"const":false},
        "caller_values_authoritative":{"const":false},
        "runtime_truth_authoritative":{"const":false}
      }
    },
    "context":{"$ref":"#/$defs/context"},
    "satisfaction":{"enum":["satisfied","unsatisfied","indeterminate","invalid"]},
    "binding_set_sha256":{"$ref":"#/$defs/sha256"},
    "bindings":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/binding"}},
    "relation_results":{"type":"array","uniqueItems":true,"items":{"oneOf":[{"$ref":"#/$defs/content_relation"},{"$ref":"#/$defs/distinct_content_relation"},{"$ref":"#/$defs/capture_relation"},{"$ref":"#/$defs/source_descriptor_relation"},{"$ref":"#/$defs/projection_relation"}]}},
    "diagnostics":{"type":"array","items":{"$ref":"#/$defs/diagnostic"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "context":{
      "type":"object","additionalProperties":false,
      "required":["contract_digest","profile_digest","evaluation_input_digest","vocabulary_version","vocabulary_complete_digest","admission_digest","exact_binding_declaration_digest","exact_binding_certification_digest"],
      "properties":{
        "contract_digest":{"$ref":"#/$defs/sha256"},
        "profile_digest":{"$ref":"#/$defs/sha256"},
        "evaluation_input_digest":{"$ref":"#/$defs/sha256"},
        "vocabulary_version":{"type":"string","minLength":1},
        "vocabulary_complete_digest":{"$ref":"#/$defs/sha256"},
        "admission_digest":{"$ref":"#/$defs/sha256"},
        "exact_binding_declaration_digest":{"$ref":"#/$defs/sha256"},
        "exact_binding_certification_digest":{"$ref":"#/$defs/sha256"}
      }
    },
    "coverage":{
      "type":"object","additionalProperties":false,"required":["role","coverage","projection","reference_ids"],
      "properties":{
        "role":{"$ref":"#/$defs/id"},"coverage":{"const":"exact"},
        "projection":{"enum":["artifact_subject","snapshot_subject","snapshot_population","projection_result_population","projection_result_reference"]},
        "population_id":{"$ref":"#/$defs/id"},
        "projection_id":{"$ref":"#/$defs/id"},
        "reference_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "binding":{
      "type":"object","additionalProperties":false,
      "required":["binding_id","requirement_id","capture_id","binding_kind","media_type","content_sha256","byte_length","role_coverage"],
      "properties":{
        "binding_id":{"$ref":"#/$defs/id"},"requirement_id":{"$ref":"#/$defs/id"},
        "capture_id":{"$ref":"#/$defs/id"},
        "binding_kind":{"enum":["artifact_bytes","complete_reachability_snapshot","observed_execution_mutation_snapshot"]},
        "media_type":{"type":"string","minLength":1},"content_sha256":{"$ref":"#/$defs/sha256"},
        "source_descriptor_sha256":{"$ref":"#/$defs/sha256"},
        "byte_length":{"type":"integer","minimum":0},
        "role_coverage":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/coverage"}}
      }
    },
    "relation_common":{
      "type":"object","required":["relation_id","operator","requirement_ids","status"],
      "properties":{
        "relation_id":{"$ref":"#/$defs/id"},
        "operator":{"enum":["same_content_sha256","distinct_content_sha256","distinct_capture_id","distinct_source_descriptor"]},
        "requirement_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "status":{"enum":["satisfied","unsatisfied"]}
      }
    },
    "content_relation":{
      "allOf":[
        {"$ref":"#/$defs/relation_common"},
        {"type":"object","additionalProperties":false,"required":["relation_id","operator","requirement_ids","status","observed_content_sha256"],
         "properties":{"relation_id":{"$ref":"#/$defs/id"},"operator":{"const":"same_content_sha256"},"requirement_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"status":{"enum":["satisfied","unsatisfied"]},"observed_content_sha256":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/sha256"}}}}
      ]
    },
    "distinct_content_relation":{
      "allOf":[
        {"$ref":"#/$defs/relation_common"},
        {"type":"object","additionalProperties":false,"required":["relation_id","operator","requirement_ids","status","observed_content_sha256"],
         "properties":{"relation_id":{"$ref":"#/$defs/id"},"operator":{"const":"distinct_content_sha256"},"requirement_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"status":{"enum":["satisfied","unsatisfied"]},"observed_content_sha256":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/sha256"}}}}
      ]
    },
    "capture_relation":{
      "allOf":[
        {"$ref":"#/$defs/relation_common"},
        {"type":"object","additionalProperties":false,"required":["relation_id","operator","requirement_ids","status","observed_capture_ids"],
         "properties":{"relation_id":{"$ref":"#/$defs/id"},"operator":{"const":"distinct_capture_id"},"requirement_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"status":{"enum":["satisfied","unsatisfied"]},"observed_capture_ids":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/id"}}}}
      ]
    },
    "source_descriptor_relation":{
      "allOf":[
        {"$ref":"#/$defs/relation_common"},
        {"type":"object","additionalProperties":false,"required":["relation_id","operator","requirement_ids","status","observed_source_descriptor_sha256"],
         "properties":{"relation_id":{"$ref":"#/$defs/id"},"operator":{"const":"distinct_source_descriptor"},"requirement_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"status":{"enum":["satisfied","unsatisfied"]},"observed_source_descriptor_sha256":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/sha256"}}}}
      ]
    },
    "projection_relation":{
      "type":"object","additionalProperties":false,
      "required":["relation_id","operator","transformer_id","source_requirement_ids","result_requirement_id","status","observed_source_content_sha256","observed_result_content_sha256","derived_content_sha256"],
      "properties":{
        "relation_id":{"$ref":"#/$defs/id"},"operator":{"const":"deterministic_projection"},
        "transformer_id":{"$ref":"#/$defs/id"},
        "source_requirement_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "result_requirement_id":{"$ref":"#/$defs/id"},"status":{"enum":["satisfied","unsatisfied"]},
        "observed_source_content_sha256":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sha256"}},
        "observed_result_content_sha256":{"$ref":"#/$defs/sha256"},
        "derived_content_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "diagnostic":{
      "type":"object","additionalProperties":false,"required":["code","message"],
      "properties":{"code":{"$ref":"#/$defs/id"},"message":{"type":"string","minLength":1},"requirement_id":{"$ref":"#/$defs/id"},"relation_id":{"$ref":"#/$defs/id"}}
    }
  },
  "$comment":"Semantic validation enforces canonical ordering, unique binding/relation IDs, declaration operand equality, operator-specific result cardinality, capture_verified only for the internal runner, and binding_set_sha256 recomputation."
}
