{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-contract-authentication-provenance-capture.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transformer_id", "acquisition_kind", "authentication_proof_sha256", "authentication_witness_sha256", "attempt_binding_proof_sha256", "attempt_binding_witness_sha256", "capture_authority_grounded_identity", "capture_authority_grounded_identity_sha256", "complete_capture_source_set_sha256", "evidence_content_sha256", "exact_normalized_applicability", "roles", "source_authentication_proof_sha256", "source_authentication_witness_sha256", "source_of_record_assignment_proof_sha256", "source_of_record_assignment_witness_sha256", "target_resolution_proof_sha256", "target_resolution_witness_sha256"],
  "properties": {
    "schema_version": { "const": "controlled-contract.authentication-provenance-occurrence-capture.v1" },
    "transformer_id": { "const": "authentication-provenance-occurrence-capture.v1" },
    "acquisition_kind": { "const": "direct" },
    "authentication_proof_sha256": { "$ref": "#/$defs/sha256" },
    "authentication_witness_sha256": { "$ref": "#/$defs/sha256" },
    "attempt_binding_proof_sha256": { "$ref": "#/$defs/sha256" },
    "attempt_binding_witness_sha256": { "$ref": "#/$defs/sha256" },
    "capture_authority_grounded_identity": { "$ref": "#/$defs/identity" },
    "capture_authority_grounded_identity_sha256": { "$ref": "#/$defs/sha256" },
    "complete_capture_source_set_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_content_sha256": { "$ref": "#/$defs/sha256" },
    "exact_normalized_applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "operand_grounded_identity_sha256", "raw_operand_reference_ids"],
      "properties": {
        "mode": { "const": "during" },
        "operand_grounded_identity_sha256": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/sha256" } },
        "raw_operand_reference_ids": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/reference_id" } }
      }
    },
    "roles": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_occurrence", "observation_attempt", "source", "target"],
      "properties": {
        "evidence_occurrence": { "$ref": "#/$defs/projected_role" },
        "observation_attempt": { "$ref": "#/$defs/projected_role" },
        "source": { "$ref": "#/$defs/projected_role" },
        "target": { "$ref": "#/$defs/projected_role" }
      }
    },
    "source_authentication_proof_sha256": { "$ref": "#/$defs/sha256" },
    "source_authentication_witness_sha256": { "$ref": "#/$defs/sha256" },
    "source_of_record_assignment_proof_sha256": { "$ref": "#/$defs/sha256" },
    "source_of_record_assignment_witness_sha256": { "$ref": "#/$defs/sha256" },
    "target_resolution_proof_sha256": { "$ref": "#/$defs/sha256" },
    "target_resolution_witness_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference_id": { "type": "string", "pattern": "^ref-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "identity": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "repository", "path"], "properties": { "kind": { "const": "repository_path" }, "repository": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "repository", "path", "symbol"], "properties": { "kind": { "const": "code_symbol" }, "repository": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "symbol": { "type": "string", "minLength": 1 }, "scip_symbol": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "domain", "value"], "properties": { "kind": { "const": "durable_id" }, "domain": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "const": "runtime_parameter" }, "name": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "term"], "properties": { "kind": { "const": "profile_term" }, "term": { "type": "string", "minLength": 1 } } }
      ]
    },
    "projected_role": {
      "type": "object", "additionalProperties": false,
      "required": ["grounded_identity_sha256", "raw_reference_id", "type_term"],
      "properties": {
        "grounded_identity_sha256": { "$ref": "#/$defs/sha256" },
        "raw_reference_id": { "$ref": "#/$defs/reference_id" },
        "type_term": { "type": "string", "minLength": 1 }
      }
    }
  }
}
