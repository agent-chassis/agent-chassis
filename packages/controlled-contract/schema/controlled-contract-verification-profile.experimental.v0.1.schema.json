      "type": "string",
      "enum": [
        "controlled-contract-verification-profile.experimental.v0.1"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "verification_falsifier_policy": {
