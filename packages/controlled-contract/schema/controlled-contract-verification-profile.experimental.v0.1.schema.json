{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "controlled-contract-verification-profile.experimental.v0.1",
  "description": "Free-tier, non-authoritative schema for versioned deterministic proof-pack patterns over a native controlled contract. Profiles are data and cannot contain executable code or prose predicates.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "evaluation_stages",
    "reference_roles",
    "claim_patterns",
    "relation_patterns",
    "collection_patterns",
    "resolver_fact_patterns",
    "evidence_patterns",
    "satisfaction_expression"
  ],
  "additionalProperties": false,
  "properties": {
