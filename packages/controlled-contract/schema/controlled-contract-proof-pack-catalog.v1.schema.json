{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-chassis.invalid/controlled-contract-proof-pack-catalog.v1.schema.json",
  "title": "controlled-contract-proof-pack-catalog.v1",
  "type": "object",
  "required": ["schema_version", "packs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "controlled-contract-proof-pack-catalog.v1"
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile_id", "profile_version", "path"],
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^proof\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "profile_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^profiles/proof\\.[a-z0-9]+(?:[.-][a-z0-9]+)*/[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        }
      }
    }
  }
}
