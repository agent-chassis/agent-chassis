{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"controlled-contract-exact-binding-certification-result.v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","profile_id","profile_version","profile_digest","exact_binding_declaration_digest","corpus","result"],
  "properties":{
    "schema_version":{"const":"controlled-contract-exact-binding-certification-result.v1"},
    "profile_id":{"type":"string","minLength":1},
    "profile_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_digest":{"$ref":"#/$defs/sha256"},
    "exact_binding_declaration_digest":{"$ref":"#/$defs/sha256"},
    "corpus":{
      "type":"object","additionalProperties":false,
      "required":["corpus_id","corpus_version","corpus_digest","executable_control_count"],
      "dependentRequired":{"executable_module":["executable_module_digest"],"executable_module_digest":["executable_module"]},
      "properties":{
        "corpus_id":{"$ref":"#/$defs/id"},
        "corpus_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "corpus_digest":{"$ref":"#/$defs/sha256"},
        "executable_module":{"type":"string","pattern":"^packages/controlled-contract/test/proof-packs/[a-z0-9._-]+\\.mjs$"},
        "executable_module_digest":{"$ref":"#/$defs/sha256"},
        "executable_control_count":{"type":"integer","minimum":1}
      }
    },
    "result":{
      "type":"object","additionalProperties":false,
      "required":["status","passed_control_ids","failed_control_ids"],
      "properties":{
        "status":{"const":"passed"},
        "passed_control_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "failed_control_ids":{"type":"array","maxItems":0,"items":{"$ref":"#/$defs/id"}}
      }
    }
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"}
  },
  "$comment":"The canonical file requires sorted unique passed_control_ids and count equality with corpus.executable_control_count. When an executable module is declared, release admission verifies its digest and executes it before comparing the actual passed IDs. The loader enforces the carrier invariants and recomputes SHA-256 from the admitted canonical file bytes."
}
