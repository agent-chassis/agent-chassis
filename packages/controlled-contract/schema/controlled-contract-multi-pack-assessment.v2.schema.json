{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-chassis.invalid/controlled-contract-multi-pack-assessment.v2.schema.json",
  "title": "controlled-contract-multi-pack-assessment.v2",
  "type": "object",
  "required": [
    "schema_version", "assessment_identity", "requested_proof_intents",
    "selected_pack_count", "evaluated_pack_count", "structure", "profile_discrimination",
    "assessment_scope", "authority", "overall_code", "stage_assessment", "per_pack", "diagnostics",
    "proof_exclusions", "missing_inputs", "digests", "lossless_report"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "controlled-contract-multi-pack-assessment.v2" },
    "assessment_identity": { "$ref": "#/$defs/sha256" },
    "stage_assessment": { "$ref": "https://agent-chassis.invalid/controlled-contract-assessment.v1.schema.json#/$defs/stage_assessment" },
    "requested_proof_intents": { "$ref": "#/$defs/string_set" },
    "selected_pack_count": { "type": "integer", "minimum": 0 },
    "evaluated_pack_count": { "type": "integer", "minimum": 0 },
    "structure": { "enum": ["proven", "not_proven", "invalid"] },
    "profile_discrimination": { "$ref": "#/$defs/axis" },
    "assessment_scope": { "const": "planning" },
    "authority": { "const": "non_authoritative" },
    "overall_code": { "type": "string", "minLength": 1 },
    "per_pack": { "type": "array", "items": { "$ref": "#/$defs/pack_result" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "proof_exclusions": { "type": "array", "items": { "$ref": "#/$defs/provenanced" } },
    "missing_inputs": { "type": "array", "items": { "$ref": "#/$defs/provenanced" } },
    "digests": {
      "type": "object",
      "required": ["algorithm", "contract", "proof_plan", "catalog", "vocabulary", "profiles", "intent_artifact", "structural_result", "proof_packs_result"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256-canonical-json-v1" },
        "contract": { "$ref": "#/$defs/sha256" },
        "proof_plan": { "$ref": "#/$defs/sha256" },
        "catalog": { "$ref": "#/$defs/sha256" },
        "vocabulary": { "$ref": "#/$defs/sha256" },
        "profiles": { "$ref": "#/$defs/sha256" },
        "intent_artifact": { "$ref": "#/$defs/sha256" },
        "structural_result": { "$ref": "#/$defs/sha256" },
        "proof_packs_result": { "$ref": "#/$defs/sha256" }
      }
    },
    "lossless_report": {
      "type": "object",
      "required": ["content_reference", "files"],
      "additionalProperties": false,
      "properties": {
        "content_reference": { "type": "string", "pattern": "^controlled-contract-assessment://sha256/[a-f0-9]{64}/manifest\\.json$" },
        "files": {
          "type": "array",
          "prefixItems": [
            { "const": "assessment.json" },
            { "const": "assessment.md" },
            { "const": "structural.full.json" },
            { "const": "proof-packs.full.json" },
            { "const": "manifest.json" }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "axis": { "enum": ["proven", "not_proven", "not_assessed"] },
    "string_set": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object",
      "required": ["profile_id", "profile_version"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_version": { "type": "string", "minLength": 1 }
      }
    },
    "provenanced": {
      "type": "object",
      "required": ["pack", "detail"],
      "additionalProperties": false,
      "properties": {
        "pack": { "oneOf": [{ "$ref": "#/$defs/provenance" }, { "type": "null" }] },
        "detail": {}
      }
    },
    "diagnostic": {
      "$ref": "#/$defs/provenanced",
      "type": "object",
      "properties": {
        "detail": {
          "type": "object",
          "required": ["source", "detail", "assessment_stage"],
          "additionalProperties": false,
          "properties": {
            "source": { "enum": ["structural_schema", "structural_validation", "structural_decomposition", "admitted_profile_evaluation", "assessment_binding", "proof_plan_input"] },
            "detail": { "type": "object" },
            "assessment_stage": { "$ref": "https://agent-chassis.invalid/controlled-contract-assessment.v1.schema.json#/properties/diagnostics/items/properties/assessment_stage" }
          }
        }
      }
    },
    "pack_result": {
      "type": "object",
      "required": [
        "profile_id", "profile_version", "requested_intents", "admission_version",
        "profile_discrimination", "guarantee", "diagnostic_count",
        "exclusion_count", "missing_input_count", "assessment_identity", "source_digests"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "profile_version": { "type": "string", "minLength": 1 },
        "requested_intents": { "$ref": "#/$defs/string_set" },
        "admission_version": { "const": 3 },
        "profile_discrimination": { "$ref": "#/$defs/axis" },
        "guarantee": { "type": "string", "minLength": 1 },
        "diagnostic_count": { "type": "integer", "minimum": 0 },
        "exclusion_count": { "type": "integer", "minimum": 0 },
        "missing_input_count": { "type": "integer", "minimum": 0 },
        "assessment_identity": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "source_digests": { "type": "object" }
      }
    }
  }
}
