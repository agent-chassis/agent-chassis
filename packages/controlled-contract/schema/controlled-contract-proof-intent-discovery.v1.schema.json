{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-chassis.invalid/controlled-contract-proof-intent-discovery.v1.schema.json",
  "title": "controlled-contract-proof-intent-discovery.v1",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "query",
    "status",
    "catalog_intent_count",
    "evaluated_intent_count",
    "total_match_count",
    "returned_count",
    "omitted_count",
    "truncated",
    "result_limit",
    "catalog_digest",
    "selection_performed",
    "pack_invocation_performed",
    "pack_admission_performed",
    "authority",
    "candidates",
    "source_identity",
    "candidate_count",
    "provider_context"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "controlled-contract-proof-intent-discovery.v1"
    },
    "mode": {
      "enum": [
        "list",
        "search",
        "detail"
      ]
    },
    "query": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "normalized_text",
            "terms"
          ],
          "additionalProperties": false,
          "properties": {
            "normalized_text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        }
      ]
    },
    "status": {
      "enum": [
        "match",
        "no_match"
      ]
    },
    "catalog_intent_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "evaluated_intent_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "total_match_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "returned_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "omitted_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "truncated": {
      "type": "boolean"
    },
    "result_limit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      ]
    },
    "catalog_digest": {
      "$ref": "#/$defs/sha256"
    },
    "selection_performed": {
      "const": false
    },
    "pack_invocation_performed": {
      "const": false
    },
    "pack_admission_performed": {
      "const": false
    },
    "authority": {
      "const": "non_authoritative"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "source_identity": {
      "type": "object",
      "required": [
        "discovery"
      ],
      "additionalProperties": false,
      "properties": {
        "discovery": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "provider_context": {
      "$ref": "#/$defs/provider_context"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "proof_name",
        "profile_version",
        "assertion",
        "matching_assertion",
        "essential_limitation",
        "exclusions",
        "constraints",
        "refinements",
        "observations",
        "capabilities",
        "provenance",
        "associations",
        "ranking"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "proof_name": {
          "$ref": "#/$defs/identifier"
        },
        "profile_version": {
          "$ref": "#/$defs/semver"
        },
        "assertion": {
          "type": "string"
        },
        "matching_assertion": {
          "type": "string"
        },
        "essential_limitation": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "refinements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "observations": {
          "type": "array"
        },
        "capabilities": {
          "type": "array"
        },
        "provenance": {
          "type": "object"
        },
        "associations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "match_kind",
            "relevance_score",
            "matched_terms",
            "unmatched_terms",
            "provider_terms",
            "semantic_terms",
            "match_reasons"
          ],
          "properties": {
            "match_kind": {
              "enum": [
                "catalog_entry",
                "assertion_match",
                "partial_assertion_match",
                "navigation_or_exclusion_match"
              ]
            },
            "relevance_score": {
              "type": "integer",
              "minimum": 0
            },
            "matched_terms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unmatched_terms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provider_terms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "semantic_terms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "match_reasons": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "provider_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider_terms",
        "families"
      ],
      "properties": {
        "status": {
          "enum": [
            "unspecified",
            "identified",
            "ambiguous",
            "conflicting"
          ]
        },
        "provider_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
