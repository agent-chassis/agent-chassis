{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"controlled-contract-exact-binding-declaration.v1.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","profile_id","profile_version","profile_digest","requirements","relations"],
  "properties":{
    "schema_version":{"const":"controlled-contract-exact-binding-declaration.v1"},
    "profile_id":{"type":"string","minLength":1},
    "profile_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_digest":{"$ref":"#/$defs/sha256"},
    "requirements":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/requirement"}},
    "relations":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/relation"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "coverage":{
      "type":"object","additionalProperties":false,
      "required":["role","coverage","projection"],
      "properties":{
        "role":{"$ref":"#/$defs/id"},
        "coverage":{"const":"exact"},
        "projection":{"enum":["artifact_subject","snapshot_subject","snapshot_population","projection_result_population"]},
        "population_id":{"$ref":"#/$defs/id"}
      }
    },
    "requirement":{
      "type":"object","additionalProperties":false,
      "required":["requirement_id","binding_kind","role_coverage"],
      "properties":{
        "requirement_id":{"$ref":"#/$defs/id"},
        "binding_kind":{"enum":["artifact_bytes","complete_reachability_snapshot","observed_execution_mutation_snapshot"]},
        "role_coverage":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/coverage"}},
        "expected_content_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "relation":{"oneOf":[{"$ref":"#/$defs/ordinary_relation"},{"$ref":"#/$defs/deterministic_projection_relation"}]},
    "ordinary_relation":{
      "type":"object","additionalProperties":false,
      "required":["relation_id","operator","requirement_ids"],
      "properties":{
        "relation_id":{"$ref":"#/$defs/id"},
        "operator":{"enum":["same_content_sha256","distinct_capture_id","distinct_source_descriptor"]},
        "requirement_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
      }
    },
    "deterministic_projection_relation":{
      "type":"object","additionalProperties":false,
      "required":["relation_id","operator","transformer_id","source_requirement_ids","result_requirement_id"],
      "properties":{
        "relation_id":{"$ref":"#/$defs/id"},
        "operator":{"const":"deterministic_projection"},
        "transformer_id":{"$ref":"#/$defs/id"},
        "source_requirement_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "result_requirement_id":{"$ref":"#/$defs/id"}
      }
    }
  },
  "$comment":"Semantic validation additionally requires unique requirement_id and relation_id values, declared relation operands, and ascending UTF-16 code-unit ordering for requirements, relations, role coverage, and each relation's requirement_ids."
}
