{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-chassis.invalid/controlled-contract-assessment.v3.schema.json",
  "title": "controlled-contract-assessment.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_scope", "authority", "assessment_status", "assessment_identity", "runtime_truth", "profile_discrimination", "population", "receipts", "diagnostics"],
  "properties": {
    "schema_version": {"const": "controlled-contract-assessment.v3"},
    "assessment_scope": {"const": "runtime"},
    "authority": {"const": "non_authoritative"},
    "assessment_status": {"enum": ["proven", "not_proven"]},
    "assessment_identity": {"$ref": "#/$defs/identity"},
    "runtime_truth": {"enum": ["proven", "not_proven"]},
    "profile_discrimination": {"enum": ["proven", "not_proven"]},
    "population": {"$ref": "#/$defs/population"},
    "receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/receipt"}},
    "diagnostics": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "allOf": [
    {"if": {"type": "object", "properties": {"assessment_status": {"const": "proven"}}}, "then": {
      "properties": {
        "runtime_truth": {"const": "proven"},
        "profile_discrimination": {"const": "proven"},
        "population": {"type": "object", "properties": {"complete": {"const": true}}},
        "receipts": {
          "type": "array",
          "items": {"type": "object", "properties": {"status": {"enum": ["passed", "detected", "proven"]}}},
          "contains": {"type": "object", "properties": {"kind": {"const": "candidate"}, "status": {"const": "passed"}}, "required": ["kind", "status"]},
          "allOf": [
            {"contains": {"type": "object", "properties": {"kind": {"const": "falsifier"}, "status": {"const": "detected"}}, "required": ["kind", "status"]}},
            {"contains": {"type": "object", "properties": {"kind": {"const": "traversal"}, "status": {"const": "proven"}}, "required": ["kind", "status"]}}
          ]
        }
      }
    }}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["verification_id", "test_id"],
      "properties": {
        "verification_id": {"type": "string", "minLength": 1},
        "test_id": {"type": "string", "minLength": 1}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "wk_id", "selected_unit", "attempt", "verifications", "contract_digest", "source_snapshot_digest", "generation_digest"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1}, "wk_id": {"type": "string", "pattern": "^WK-[0-9]+$"},
        "selected_unit": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1},
        "verifications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/verification"}},
        "contract_digest": {"$ref": "#/$defs/sha256"}, "source_snapshot_digest": {"$ref": "#/$defs/sha256"},
        "generation_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "population": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_count", "falsifier_count", "traversal_count", "complete"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 1}, "falsifier_count": {"type": "integer", "minimum": 1},
        "traversal_count": {"type": "integer", "minimum": 1}, "complete": {"type": "boolean"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["receipt_id", "verification_id", "kind", "status", "provider", "authenticated_identity", "evidence_artifact_ids"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^receipt-[a-f0-9]{64}$"},
        "verification_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["candidate", "falsifier", "traversal"]},
        "status": {"enum": ["passed", "detected", "proven", "failed", "inert", "unproven", "refused"]},
        "provider": {"type": "object", "additionalProperties": false, "required": ["provider_id", "provider_version", "capability"], "properties": {
          "provider_id": {"type": "string", "minLength": 1}, "provider_version": {"type": "string", "minLength": 1}, "capability": {"enum": ["candidate_execution", "falsifier_execution", "boundary_traversal"]}
        }},
        "authenticated_identity": {"type": "object", "additionalProperties": false, "required": ["run_id", "source_snapshot_digest", "receipt_digest"], "properties": {
          "run_id": {"type": "string", "minLength": 1}, "source_snapshot_digest": {"$ref": "#/$defs/sha256"}, "receipt_digest": {"$ref": "#/$defs/sha256"}
        }},
        "evidence_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"type": "object", "properties": {"kind": {"const": "candidate"}}, "required": ["kind"]}, "then": {
          "properties": {"provider": {"type": "object", "properties": {"capability": {"enum": ["candidate_execution"]}}}, "status": {"enum": ["passed", "failed", "refused"]}}
        }},
        {"if": {"type": "object", "properties": {"kind": {"const": "falsifier"}}, "required": ["kind"]}, "then": {
          "properties": {"provider": {"type": "object", "properties": {"capability": {"enum": ["falsifier_execution"]}}}, "status": {"enum": ["detected", "inert", "refused"]}}
        }},
        {"if": {"type": "object", "properties": {"kind": {"const": "traversal"}}, "required": ["kind"]}, "then": {
          "properties": {"provider": {"type": "object", "properties": {"capability": {"enum": ["boundary_traversal"]}}}, "status": {"enum": ["proven", "unproven", "refused"]}}
        }}
      ]
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "pointer", "severity"],
      "properties": {"code": {"type": "string", "pattern": "^runtime_[a-z0-9_]+$"}, "pointer": {"type": "string", "pattern": "^/"}, "severity": {"enum": ["error", "warning", "info"]}, "message": {"type": "string", "maxLength": 512}}
    }
  }
}
