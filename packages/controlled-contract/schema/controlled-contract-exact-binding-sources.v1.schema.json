{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"controlled-contract-exact-binding-sources.v1.schema.json",
  "type":"object",
  "propertyNames":{"$ref":"#/$defs/id"},
  "additionalProperties":{"oneOf":[
    {"$ref":"#/$defs/artifact"},
    {"$ref":"#/$defs/reachability"},
    {"$ref":"#/$defs/mutations"}
  ]},
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "relative_path":{"type":"string","minLength":1,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"},
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["kind","relative_path"],
      "properties":{"kind":{"const":"artifact_file"},"relative_path":{"$ref":"#/$defs/relative_path"}}
    },
    "node":{
      "type":"object","additionalProperties":false,"required":["reference_id"],
      "properties":{"reference_id":{"type":"string","minLength":1}}
    },
    "edge":{
      "type":"object","additionalProperties":false,"required":["from_reference_id","to_reference_id"],
      "properties":{"from_reference_id":{"type":"string","minLength":1},"to_reference_id":{"type":"string","minLength":1}}
    },
    "reachability_snapshot":{
      "type":"object","additionalProperties":false,
      "required":["complete","subject_reference_id","nodes","edges"],
      "properties":{
        "complete":{"const":true},
        "subject_reference_id":{"type":"string","minLength":1},
        "nodes":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/node"}},
        "edges":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/edge"}}
      }
    },
    "reachability":{
      "type":"object","additionalProperties":false,"required":["kind","snapshot"],
      "properties":{"kind":{"const":"complete_reachability_snapshot"},"snapshot":{"$ref":"#/$defs/reachability_snapshot"}}
    },
    "mutation":{
      "type":"object","additionalProperties":false,
      "required":["mutation_id","operation","target_reference_id"],
      "properties":{
        "mutation_id":{"$ref":"#/$defs/id"},
        "operation":{"enum":["create","delete","mutate","write"]},
        "target_reference_id":{"type":"string","minLength":1},
        "before_sha256":{"$ref":"#/$defs/sha256"},
        "after_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "mutation_snapshot":{
      "type":"object","additionalProperties":false,
      "required":["complete","subject_reference_id","mutations"],
      "properties":{
        "complete":{"const":true},
        "subject_reference_id":{"type":"string","minLength":1},
        "mutations":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/mutation"}}
      }
    },
    "mutations":{
      "type":"object","additionalProperties":false,"required":["kind","snapshot"],
      "properties":{"kind":{"const":"observed_execution_mutation_snapshot"},"snapshot":{"$ref":"#/$defs/mutation_snapshot"}}
    }
  }
}
