{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "controlled-contract-proof-pack-adequacy-run.experimental.v0.1",
  "description": "Machine-readable observations returned by a proof pack's executable adequacy module.",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "profile_digest",
    "guarantee_digest",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "passed": {
      "type": "boolean",
      "description": "Additional required pack checks, when supplied. False always fails certification; true never overrides control diagnostics."
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "controlled-contract-proof-pack-adequacy-run.experimental.v0.1"
      ]
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "guarantee_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "category",
          "implementation_outcome",
          "profile_satisfaction"
        ],
        "additionalProperties": false,
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "type": "string",
            "enum": [
              "positive",
              "mutant",
              "profile_rejection",
              "exclusion"
            ]
          },
          "implementation_outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "killed",
              "survived",
              "not_applicable",
              "boundary_demonstrated"
            ]
          },
          "profile_satisfaction": {
            "type": "string",
            "enum": [
              "satisfied",
              "unsatisfied",
              "invalid",
              "indeterminate",
              "not_evaluated"
            ]
          },
          "rejection": {
            "description": "Executed negative-control observation. Expected reasons must be authored independently of the observed result. Transformer observations do not establish evaluator rejection.",
            "type": "object",
            "required": ["checker", "subject", "expected_reason", "actual_reason"],
            "additionalProperties": false,
            "properties": {
              "checker": { "enum": ["proof_evaluator", "profile_conformance", "transformer"] },
              "subject": { "enum": ["evaluation_input", "profile", "transformer_input"] },
              "expected_reason": { "type": "string", "minLength": 1 },
              "actual_reason": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
