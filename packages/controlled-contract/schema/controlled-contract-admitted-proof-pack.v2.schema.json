{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controlled-contract-admitted-proof-pack.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "profile_digest",
    "guarantee",
    "guarantee_digest",
    "explicit_exclusions",
    "certification"
  ],
  "properties": {
    "schema_version": { "const": "controlled-contract-admitted-proof-pack.v2" },
    "profile_id": { "type": "string", "pattern": "^proof\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile_digest": { "$ref": "#/$defs/sha256" },
    "guarantee": { "type": "string", "minLength": 1 },
    "guarantee_digest": { "$ref": "#/$defs/sha256" },
    "explicit_exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "adequacy_declaration_digest",
        "adequacy_result_digest",
        "executable_control_count",
        "negative_fixture_count",
        "coverage_witness_count"
      ],
      "properties": {
        "method": {
          "enum": [
            "executable_adequacy_full_negative_corpus",
            "executable_semantic_adequacy"
          ]
        },
        "adequacy_declaration_digest": { "$ref": "#/$defs/sha256" },
        "adequacy_result_digest": { "$ref": "#/$defs/sha256" },
        "executable_control_count": { "type": "integer", "minimum": 1 },
        "negative_fixture_count": { "type": "integer", "minimum": 0 },
        "coverage_witness_count": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": { "const": "executable_adequacy_full_negative_corpus" }
            }
          },
          "then": {
            "properties": {
              "coverage_witness_count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": { "const": "executable_semantic_adequacy" }
            }
          },
          "then": {
            "properties": {
              "negative_fixture_count": { "type": "integer", "const": 0 },
              "coverage_witness_count": { "type": "integer", "const": 0 }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$" }
  }
}
