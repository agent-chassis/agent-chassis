    "binding_constraint_patterns": {
      "const": []
    },
    "claim_patterns": {
      "const": []
    },
    "relation_patterns": {
      "const": []
    },
    "collection_patterns": {
      "const": []
    },
    "resolver_fact_patterns": {
      "const": []
    },
    "evidence_patterns": {
      "const": []
    },
    "falsifier_condition_bindings": {
      "const": []
    },
    "falsifier_occurrence_bindings": {
      "const": []
    },
