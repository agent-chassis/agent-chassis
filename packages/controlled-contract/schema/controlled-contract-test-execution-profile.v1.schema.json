    },
    "vocabulary_definitions_digest": {
      "const": "10a7964948bfc8323ac7636047034c17db75af05168f6f242afb12e2f6bf4d38"
    },
    "vocabulary_complete_digest": {
      "const": "e7b23dee357a5893f14e931905c736d42442b47debbf713aaef88afeb16184af"
    },
