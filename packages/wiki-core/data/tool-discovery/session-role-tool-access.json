{
  "schema_version": "session-role-tool-access.v2",
  "kind": "session-role-tool-access-policy",
  "repository": "agent-chassis/agent-chassis",
  "policy_id": "session-role-tool-access",
  "description": "Single authoritative startup-static role and deployment-disposition policy for the wiki-mcp server. Each entry in `access` maps a registered agent-reachable operation to its session-role grants; each sibling `dispositions` entry contains exactly one value from the closed wiki-core vocabulary. The role gate composes independently with descriptor-owned audience, tier_visibility, install_state, and runtime_posture. This file does not own those descriptor axes. Omission or incompatibility is a loud policy failure; no runtime or lint consumer may infer a default policy.",
  "roles": [
    "orchestrator",
    "reviewer",
    "worker",
    "redteam",
    "operator"
  ],
  "role_descriptions": {
    "orchestrator": "Coordinator surface: all CONTENT reads plus the process/dispatch-measurement reads (validate_dispatch, coordination_preflight, initiative_status, integration_status, agent_run_status, agent_run_wait, node_engine_admission_runtime_diagnostic), the authenticated workspace_verify_proof route, and the action/authority tools (dispatch, work_record_* setters, create_record, generate_and_lint/lint/docs hygiene, run_validation, review-recording). Not commit, not submit_for_review.",
    "reviewer": "Findings-only reviewer: broad CONTENT read/inspect/navigation surface, launcher-bound workspace_verify_proof, plus workspace_submit_for_review. No process-measurement, mutation, or authority tools.",
    "worker": "Managed implementation worker: the closed-input commit primitive plus the launcher-owned declared-test capability workspace_worker_run_declared_test and launcher-bound workspace_verify_proof; their unit and worktree are bound from the dispatched run rather than caller input and their results are advisory (the worker still reads via its sandboxed filesystem, not wiki-mcp); trusted integration freezes the later review target.",
    "redteam": "Findings-only redteam: same broad CONTENT read surface as reviewer plus workspace_submit_for_review. No process-measurement, mutation, or authority tools.",
    "operator": "Every policy-granted operator route, including cache writers and operator observability; launcher-managed role-bound capabilities may exclude operator."
  },
