  "repository": "agent-chassis/agent-chassis",
  "policy_id": "session-role-tool-access",
  "description": "Single authoritative startup-static role and deployment-disposition policy for the wiki-mcp server. Each entry in `access` maps a registered agent-reachable operation to its session-role grants; each sibling `dispositions` entry contains exactly one value from the closed wiki-core vocabulary. The role gate composes independently with descriptor-owned audience, tier_visibility, install_state, and runtime_posture. This file does not own those descriptor axes. Omission or incompatibility is a loud policy failure; no runtime or lint consumer may infer a default policy.",
  "roles": [
    "orchestrator",
    "reviewer",
    "worker",
    "redteam",
    "operator"
  ],
  "role_descriptions": {
    "orchestrator": "Fifteen task tools for canonical reading, authoring, assessment, start, original outcomes and explicit integration/candidate/publication actions. Delivery is worker-owned.",
    "reviewer": "Findings-only reads and assessment of authenticated source, native tests, proof execution and own native outcomes. No start, authoring, integration or publication.",
    "worker": "Five assignment-bound tasks: read assignment, run test, verify proof, read own recorded outcomes and deliver work.",
    "redteam": "Findings-only canonical and proof discovery reads and assessment. No execution or result observation.",
    "operator": "Preserved operator-only recovery tools and explicitly granted canonical task replacements. No launcher-managed execution, start or delivery."
  },
