      "notes": "Agent-safe MCP route for persisting graph-impact derived evidence onto a WK or slice. Resolves the workspace through configured aliases; rejects caller-supplied filesystem roots and shell output as authority. The graph_impact payload must be the complete workspace_code_index_impact answer (verbose:true, or the retained original at full_result), and the persisted entry is validated against the work-record schema before writing. Compact by default; verbose:true for raw graph_state and full derived evidence.",
      "use_when": [
        "Persist a complete workspace_code_index_impact answer onto a WK or slice as graph-impact evidence."
      ],
      "do_not_use_when": [
        "Impact only needs to be read; workspace_code_index_impact itself records nothing."
      ],
      "authoritative_for": [
        "WK-stored graph-impact derived evidence"
      ],
      "recommended_first_call": {
        "operation": "record a complete impact answer for one work unit",
        "arguments": {
          "unit": "$work_record_unit",
          "graph_impact": "$complete_impact_answer"
        },
        "omit_null_arguments": true
      }
    },
