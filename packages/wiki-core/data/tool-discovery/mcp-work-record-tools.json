      "notes": "Assigns one record-level WK to an existing initiative by writing only the canonical `WK.initiative` scalar. The initiative is validated read-only and never written, so membership stays derived from WK records. Repeating the current assignment is a no-op; reassignment is one CAS-protected WK write. Slice selectors and conflicting aliases refuse.",
      "use_when": [
        "A record-level WK must be assigned or reassigned to an existing initiative."
      ],
      "do_not_use_when": [
        "The target is a slice, or the initiative record itself must change; slices refuse and initiative edits use the initiative amend routes."
      ],
      "authoritative_for": [
        "canonical WK.initiative assignment"
      ],
      "recommended_first_call": {
        "operation": "assign one WK to an initiative",
        "arguments": {
          "unit": "$unit_if_known",
          "initiative": "$initiative_if_known"
        },
        "omit_null_arguments": true
      }
