{
  "schema_version": "tool-discovery.v1",
  "kind": "tool-discovery-fragment",
  "repository": "agent-chassis/agent-chassis",
  "fragment": "mcp-launcher-tools.json",
  "summary": "MCP launcher, runtime diagnostic, and dispatch-readiness tools.",
  "tool_count": 1,
  "tools": [
    {
      "tool_name": "workspace_preflight_dispatch",
      "display_name": "Workspace preflight dispatch",
      "kind": "mcp_tool",
      "entrypoint": "workspace_preflight_dispatch",
      "task_ids": [
        "validate-dispatch"
      ],
      "install_state": "installed",
      "runtime_posture": "supported",
      "recommended_route": "mcp",
      "audience": [
        "operator"
      ],
      "priority": 34,
      "side_effects": [
        "read_only"
      ],
      "authority": [
        "checked_in_descriptor",
        "operator_input",
        "workspace_repo"
      ],
      "tier_visibility": [
        "operator_only"
      ],
      "docs_refs": [
        "docs/mcp-operation-reference.md",
        "docs/mcp-integration.md"
      ],
      "source_files": [
        "packages/wiki-mcp/src/lib/work-record-read-tools.mjs",
        "packages/wiki-core/src/operations/prospective-dispatch-preflight.mjs"
      ],
      "notes": "Read-only validation of an unpersisted proposed work-record dispatch contract. It does not mutate canonical records or admission evidence.",
      "use_when": [
        "Operator needs readiness diagnostics for a proposed record before it is persisted."
      ],
      "do_not_use_when": [
        "The record is canonical; assess it with start_agent({subject,preview:true}) using its exact durable unit address."
      ],
      "authoritative_for": [
        "structural preflight of caller-supplied proposed record content"
      ],
      "recommended_first_call": {
        "operation": "preflight one proposed record",
        "arguments": {
          "repo": "$configured_workspace_alias",
          "proposed_record": "$proposed_record"
        },
        "omit_null_arguments": true
      }
    }
  ]
}
