#!/usr/bin/env node

if (process.argv.slice(2).some((arg) => arg === "--help" || arg === "-h" || arg === "help")) {
  console.log(`wiki-mcp

Start the AgentChassis wiki MCP stdio server.

Usage:
  wiki-mcp

Options:
  -h, --help  Show this help text.`);
  process.exit(0);
}

// WK-2139: a standalone wiki-mcp launch carries NO package documentation
// bundle, so it supplies no documentation carrier and advertises no
// package-owned documentation reference it cannot read. Only a forwarding
// package that actually owns a docs bundle (`@agent-chassis/core`) passes one.
const { startWikiMcpServer } = await import("../src/server.mjs");

await startWikiMcpServer();
