{
  "annotations": [
    {
      "annotation_id": "ann-authority-boundary",
      "kind": "rationale",
      "text": "WK-1782 is the single owner of construction, recheck, and compare-and-swap behavior; WK-1783 is the single owner of public failure projection. WK-2225 changes only the mutant test module."
    },
    {
      "annotation_id": "ann-disposition-evidence",
      "kind": "note",
      "text": "Worker-returned witness evidence is completion evidence, not a repository write or authority to modify owner surfaces. Durable routing and successor allocation remain coordinator actions."
    },
    {
      "annotation_id": "ann-execution-generation",
      "kind": "provenance",
      "text": "Every execution and review binds to the exact current canonical contract generation and accumulated WK tip selected by launcher authority under DEC-0154 and DEC-0179."
    },
    {
      "annotation_id": "ann-validation-boundary",
      "kind": "rationale",
      "text": "Acceptance validation is coordinator-owned after delivery under DEC-0158; a worker may run an advisory declared test only through launcher-owned capability."
    },
    {
      "annotation_id": "ann-review-boundary",
      "kind": "rationale",
      "text": "The exact committed implementation slice receives findings-only review before trusted integration under DEC-0164."
    },
    {
      "annotation_id": "ann-design-review-disposition",
      "kind": "provenance",
      "text": "DRY run wkdb_a39bad2d5c048774 produced DRY-001 through DRY-010 and DEC run wkdb_e0a6e7c11051719f produced four DEC findings, numbered 001 through 004; the coordinator accepted and dispositioned every finding once before authoring this contract."
    },
    {
      "annotation_id": "ann-review-remediation-proof-rebind",
      "kind": "provenance",
      "text": "After the first exact-slice review and its single blueteam challenge, the accepted remediation deletes duplicate candidate-module mutant plumbing and retains the unique durable-ref authority witness. The retain-unique verification therefore traverses the runtime module boundary exercised by that surviving witness; its historical stable verification identity is preserved while its proposition and falsifier bindings are corrected."
    }
  ],
