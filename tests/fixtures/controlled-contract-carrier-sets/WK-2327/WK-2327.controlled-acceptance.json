{
  "annotations": [
    {
      "annotation_id": "ann-wk2327-provenance",
      "kind": "rationale",
      "text": "The new agent-launch-core owner constructs the complete agent-run-provenance.v1 envelope and its artifact descriptors; reviewed launch and direct capture only observe facts and persist success or a non-provenance construction diagnostic."
    },
    {
      "annotation_id": "ann-wk2327-distinct-contracts",
      "kind": "rationale",
      "text": "structured-dispatch-provenance.v1 construction and agent-run-provenance-inspection.v1 inspection are separate contracts with separate owners and are not fallbacks for agent-run-provenance.v1 construction."
    },
    {
      "annotation_id": "ann-wk2327-result-mode",
      "kind": "rationale",
      "text": "The result-mode module remains the sole vocabulary, classification, validation, complete-envelope construction, equality, and bounded legacy-compatibility owner. One family-neutral final-result seam invokes that owner after terminal facts exist. Codex and Claude adapters transport facts only and do not construct or attach complete semantic envelopes. selected_contract names the selected structured-result contract; mode names the classified outcome."
    },
    {
      "annotation_id": "ann-wk2327-transport",
      "kind": "rationale",
      "text": "Receipt storage and recovery validate and transport complete envelopes. Current evidence must match exactly; missing or conflicting evidence refuses mechanically instead of selecting a source."
    },
    {
      "annotation_id": "ann-wk2327-reviews",
      "kind": "provenance",
      "text": "DRY review wkdb_3540b7a24ece0cf3 produced four accepted medium findings. Historical adopted-decision review wkdb_69a6acbe8c22fb68 covered only DEC-0177 through DEC-0181. Corrective adopted-decision review wkdb_e272ef3dd07c0f5a covered all 51 accepted decisions and retained F-001 through F-003; SLICE-026 and SLICE-027 were cancelled and SLICE-033 owns the family-neutral correction. The review artifact is immutable; its selected-lineage settlement remains operator_recovery_needed."
    },
    {
      "annotation_id": "ann-wk2327-forbidden-population",
      "kind": "rationale",
      "text": "The complete WK-2327 forbidden population covers reviewed-launch envelope construction, direct-capture envelope construction, receipt-local selection/reconstruction, recovery-local selection/reconstruction, and complete result-mode attachment from either family adapter. The family-neutral terminal seam is the sole semantic consumer of adapter facts."
    }
  ],
