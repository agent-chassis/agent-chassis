{
  "annotations": [
    {
      "annotation_id": "ann-design-disposition",
      "kind": "rationale",
      "text": "DRY findings were dispositioned once and all accepted; the all-accepted-decision review then examined 51/51 accepted decisions and its two DEC-0118 findings were dispositioned once and accepted. D3 is the resulting contract design."
    },
    {
      "annotation_id": "ann-envelope-owner",
      "kind": "note",
      "text": "The wiki-MCP assessment materializer is the sole final-envelope budget owner. It reserves workspaceRepo, assessment_identity, exact counts, omitted counts, and continuation metadata once, then passes the remaining allowance to semantic projection."
    },
    {
      "annotation_id": "ann-losslessness",
      "kind": "note",
      "text": "Summary and page byte ceilings are delivery bounds only. Complete task-relevant rows and values remain snapshot-bound and reachable through typed collection, field-projection, and scalar-range continuations on the existing query routes."
    },
    {
      "annotation_id": "ann-proof-obligations",
      "kind": "note",
      "text": "Six executable verification claims collectively cover all twelve behavior claims. Each binds candidate execution, module boundary traversal, a dependency-failure falsifier, an observable structured diagnostic, and an honest no-executed-coverage baseline before implementation."
    },
    {
      "annotation_id": "ann-public-boundary",
      "kind": "rationale",
      "text": "Raw carriers, artifacts, proof plans, evaluation inputs, and evaluator join graphs are outside the assessment public contract under WK-2426. Non-task-relevant source digests and assessment completeness exemptions are removed rather than relabeled."
    },
    {
      "annotation_id": "ann-scope",
      "kind": "rationale",
      "text": "This work changes public assessment transport and projection only. It preserves controlled-contract and proof-pack evaluation semantics, proof authority, CCE, role permissions, WK-2426 policy, and the single existing snapshot registry."
    }
  ],
